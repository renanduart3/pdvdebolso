{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdv-de-bolso-pagamentos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "https://pdvdebolso.com",
    "ALLOWED_ORIGINS": "https://pdvdebolso.com,https://www.pdvdebolso.com,http://localhost:5173,http://127.0.0.1:5173",
    "LICENSE_PRICE_BRL": "5.00"
  },
  "kv_namespaces": [
    {
      "binding": "LICENCAS"
    }
  ],
  "secrets": {
    "required": [
      "MP_ACCESS_TOKEN",
      "MP_WEBHOOK_SECRET",
      "LICENSE_SIGNING_SECRET"
    ]
  }
}
